# Copy to .env for local runs outside Docker. docker-compose sets its own.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres on 5440 — 5432/5433 are usually taken by another local stack.
#
# The application connects as the NON-OWNER role, because row-level security does
# not apply to a table's owner (ADR-0006). The owner URL is for migrations and
# for the one deliberate cross-tenant job; it defaults to DATABASE_URL, which is
# fine for a single-role setup but then RLS is not in force.
DATABASE_URL=postgres://mio_app:mio_app@localhost:5440/mio
DATABASE_OWNER_URL=postgres://mio:mio@localhost:5440/mio
# Integration tests create one database per test file from this server.
DATABASE_URL_TEST=postgres://mio:mio@localhost:5440/mio  # the owner: the helper creates and drops databases

# Signs the short-lived player tokens the operator exchanges its player id for.
PLAYER_TOKEN_SECRET=dev-player-token-secret-change-me

# The two simulated operators.
CASINO_MOCK_BASE_URL=http://localhost:3010
CASINO_MOCK_PORT=3010

# Outbox relay and reward issuance.
OUTBOX_POLL_MS=250
ISSUANCE_TIMEOUT_MS=2000
ISSUANCE_MAX_ATTEMPTS=5
HMAC_TOLERANCE_SECONDS=300
